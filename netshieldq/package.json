{
  "name": "netshieldq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "electron:run": "electron ./electron/main.js",
    "electron:serve": "npm run build && electron ./electron/main.js",
    "electron:build": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "axios": "^1.6.8",
    "core-js": "^3.8.3",
