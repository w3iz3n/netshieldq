    "crystals-kyber": "^5.1.0",
    "electron": "^30.0.4",
    "element-ui": "^2.15.14",
    "express": "^4.19.2",
    "fs": "^0.0.1-security",
    "js-sha256": "^0.11.0",
    "morgan": "^1.10.0",
    "mqtt": "^5.5.4",
    "net": "^1.0.2",
    "nmap": "^1.1.0",
    "node-nmap": "^4.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "public-ip": "^6.0.2",
    "stream-browserify": "^3.0.0",
    "vue": "^2.6.14",
    "vue-router": "^3.6.5",
    "vuetify": "^2.6.4",
    "vuex": "^3.6.2",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "^5.0.8",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "vue-template-compiler": "^2.6.14",
    "webpack": "^5.65.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "no-unused-vars": "off",
      "no-empty": "off",
      "no-import-assign": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
